# ==========================================
# Large Data Files & Datasets
# ==========================================
# Block all Parquet files across the entire repository
*.parquet

# data/raw/
*.jsonl

# Ignore full raw datasets
data/raw/
*.parquet
*.pq

# Block intermediate pipeline tables
data/interim/

# Block raw Excel sheets (e.g. JISDOR export)
*.xlsx
*.xls

# data/processed/articles_aligned/

repo_samples

# !data/raw_sample/

# ==========================================
# Jupyter Notebooks & Caches
# ==========================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_office.db
Desktop.ini
$RECYCLE.BIN/

# IDEs (VS Code, PyCharm, etc.)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
*.env
credentials.json
*-credentials.json
service_account.json

# -------------
# Explicitly track samples
!data/samples/
!data/samples/*.parquet
!data/samples/*.csv